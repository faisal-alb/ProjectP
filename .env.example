# The only env file in the monorepo. Copy to .env at the repo root.
# Nothing under apps/, packages/ or services/ has its own: the API, the Solana
# scripts and the web app (next.config.ts loads it) all read this one, and
# docker compose can pass it to every service with `env_file: .env`.
# Per-cluster values (.env.<cluster>) are written by `npm run solana:setup`
# and the API. Restart dev servers after changing anything here.

# ── Web (apps/web) ─────────────────────────────────────────────────────────
# Where the browser reaches the API.
# NEXT_PUBLIC_API_URL=http://localhost:8787
# Mapbox public token (pk.…).
# NEXT_PUBLIC_MAPBOX_TOKEN=
# Sessions (better-auth). Secret: 32+ random chars, e.g. `openssl rand -base64 32`.
# BETTER_AUTH_SECRET=
# BETTER_AUTH_URL=http://localhost:3000
# Build a second copy of the app elsewhere (e2e tests).
# NEXT_DIST_DIR=.next

# ── Voice assistant (server only; see docs/voice-agent.md) ─────────────────
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=

# ── API (apps/api) ─────────────────────────────────────────────────────────
# API_PORT=8787
# WEB_ORIGIN=http://localhost:3000

# ── Scripts / e2e ──────────────────────────────────────────────────────────
# API_URL=http://localhost:8787
# WEB_URL=http://localhost:3000

# ── Solana ─────────────────────────────────────────────────────────────────
# localnet (default) | devnet | mainnet-beta
SOLANA_CLUSTER=localnet
# Defaults: http://127.0.0.1:8899 (localnet), https://api.devnet.solana.com (devnet)
# SOLANA_RPC_URL=

# The token treated as USDC. Created by `npm run solana:setup` on localnet/devnet.
# USDC_MINT=

# Service keypairs (Solana CLI JSON). Default to .keys/<name>.keypair.json.
# DEPLOYER_KEYPAIR_PATH=
# VERIFIER_KEYPAIR_PATH=
# MINT_AUTHORITY_KEYPAIR_PATH=

# 32 random bytes, base64. Encrypts managed household wallets.
# Generated automatically on localnet/devnet; required on mainnet.
# WALLET_ENCRYPTION_KEY=
