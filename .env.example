# Copy to .env (shared) or .env.<cluster> (per cluster). Values written by
# `npm run solana:setup` and the API land in .env.<cluster> automatically.

# localnet (default) | devnet | mainnet-beta
SOLANA_CLUSTER=localnet
# Defaults: http://127.0.0.1:8899 (localnet), https://api.devnet.solana.com (devnet)
# SOLANA_RPC_URL=

# The token treated as USDC. Created by `npm run solana:setup` on localnet/devnet.
# USDC_MINT=

# Service keypairs (Solana CLI JSON). Defaults to .keys/<name>.keypair.json.
# DEPLOYER_KEYPAIR_PATH=
# VERIFIER_KEYPAIR_PATH=
# MINT_AUTHORITY_KEYPAIR_PATH=

# 32 random bytes, base64. Encrypts managed household wallets.
# Generated automatically on localnet/devnet; required on mainnet.
# WALLET_ENCRYPTION_KEY=

# API
# API_PORT=8787
# WEB_ORIGIN=http://localhost:3000

# Web (apps/web)
# NEXT_PUBLIC_API_URL=http://localhost:8787

# Mapbox public token (pk.…). Set in apps/web/.env.local; restart Next.js after changing.
# NEXT_PUBLIC_MAPBOX_TOKEN=
