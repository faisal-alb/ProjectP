# Every image builds from the repo root. Keep secrets, local state and build
# output out of the context. Dokploy writes the Environment tab to a .env file
# here, so without these lines secrets would be copied into image layers.
.env
.env.*
!.env.example
.keys
**/.data

# Dependencies and build output, rebuilt inside the image
**/node_modules
**/.next
**/.next-*
**/*.tsbuildinfo
**/test-results
**/playwright-report
.venv
**/__pycache__
**/*.py[cod]

# Trained models and downloads: mounted into the intelligence container at runtime
ml/artifacts
ml/data_cache

# Not needed by any image
.git
.claude
.agents
docs
programs
target
test-ledger
**/.DS_Store

# Key material may be stored outside .keys locally.
**/*.keypair.json
**/*.pem
**/*.key
**/*.p12
**/*.pfx
