{
  "name": "projectp",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@11.20.0",
  "engines": {
    "node": ">=20.9.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "npm run dev --workspace=web",
    "dev:intelligence": "node services/intelligence/dev.mjs",
    "intelligence:setup": "node services/intelligence/setup.mjs",
    "ml:train": ".venv/bin/python -m ml.build_artifacts",
    "build": "npm run build --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "solana:setup": "tsx scripts/solana/setup.ts",
    "solana:faucet": "tsx scripts/solana/faucet.ts",
    "solana:demo": "tsx scripts/solana/demo-flow.ts",
    "solana:generate": "npm run generate -w @gridflex/solana",
    "solana:api-smoke": "tsx scripts/solana/api-smoke.ts"
  },
  "devDependencies": {
    "@gridflex/shared": "*",
    "@gridflex/solana": "*",
    "tsx": "^4"
  },
  "dependencies": {
    "approve": "^0.0.12"
  },
  "allowScripts": {
    "unrs-resolver": true
  }
}
