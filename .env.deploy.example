# Copy to .env.deploy for local Compose; paste real values in Dokploy Environment.
WEB_ORIGIN=https://gridflex.example.com
BETTER_AUTH_URL=https://gridflex.example.com
NEXT_PUBLIC_API_URL=https://api.gridflex.example.com
NEXT_PUBLIC_MAPBOX_TOKEN=
BETTER_AUTH_SECRET=
SOLANA_CLUSTER=devnet
SOLANA_RPC_URL=https://api.devnet.solana.com
# Paste each existing Solana CLI keypair as a single-line JSON array of 64 bytes.
# Leave empty only when provisioning files/keys/*.keypair.json instead.
DEPLOYER_KEYPAIR_JSON=
VERIFIER_KEYPAIR_JSON=
MINT_AUTHORITY_KEYPAIR_JSON=
USDC_MINT=
WALLET_ENCRYPTION_KEY=
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=
REPLAY_AT=
# Dokploy persists files next to its checkout. Locally use ./.data/compose.
FILES_DIR=../files

# Shared-run control access. Set a long random private value.
PRESENTER_ACCESS_CODE=
RUN_SPEND_LIMIT_BASE=1000000000
RUN_EVENT_LIMIT_BASE=100000000
